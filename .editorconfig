# The style AGENTS.md states, in the form editors read.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Generated by tree-sitter; not ours to reformat.
[src/{parser.c,grammar.json,node-types.json}]
indent_size = unset
trim_trailing_whitespace = unset

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
