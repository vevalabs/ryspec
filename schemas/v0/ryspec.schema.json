{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/vevalabs/ryspec/main/schemas/v0/ryspec.schema.json",
  "title": "ryspec document",
  "description": "A ryspec specification document.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "title": "Format version",
      "description": "The ryspec format version.",
      "type": "string",
      "const": "0"
    },
    "meta": {
      "title": "Metadata",
      "description": "Descriptive information about the document.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "description": "A short name for the document.",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "description": "A summary of the document.",
          "type": "string"
        }
      }
    },
    "variables": {
      "title": "Variables",
      "description": "Declarations of the values monitors read, publish or are configured with.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/variable" }
    },
    "monitors": {
      "title": "Monitors",
      "description": "Runtime interfaces over the document's properties, keyed by name. Monitors sit at the root alone: no namespace holds one.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/monitor" }
    },
    "rules": {
      "title": "Rules",
      "description": "Rules of the anonymous namespace, keyed by name.",
      "$ref": "#/definitions/ruleTable"
    },
    "properties": {
      "title": "Properties",
      "description": "Properties of the anonymous namespace, keyed by name.",
      "$ref": "#/definitions/propertyTable"
    },
    "namespace": {
      "title": "Namespaces",
      "description": "Named namespaces, nested by path. This table is no namespace itself, so it holds no `rules`, `properties` or `extras`: the anonymous namespace's sit at the root.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "properties": { "rules": false, "properties": false, "extras": false },
      "additionalProperties": { "$ref": "#/definitions/namespace" }
    },
    "extras": {
      "title": "Extras",
      "description": "Free-form data. The format does not interpret it.",
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "monitor": {
      "title": "Monitor",
      "description": "A runtime interface: the variables it reads and publishes, and its runtime settings.",
      "type": "object",
      "required": ["outputs"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "title": "Runtime",
          "description": "Settings of the monitor runtime.",
          "type": "object",
          "additionalProperties": false,
          "dependencies": { "base_period": ["time_unit"] },
          "properties": {
            "allocation_size": {
              "title": "Allocation size",
              "description": "Allocation size of the monitor runtime.",
              "type": "integer",
              "minimum": 1
            },
            "buffer_size": {
              "title": "Buffer size",
              "description": "Buffer size of the monitor runtime.",
              "type": "integer",
              "minimum": 1
            },
            "base_period": {
              "title": "Base period",
              "description": "Time between two consecutive samples, in the monitor's `time_unit`, which a base period therefore requires.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "time_unit": {
              "title": "Time unit",
              "description": "Unit of the monitor's timestamps, and the default unit of metric bounds.",
              "$ref": "#/definitions/timeUnit"
            }
          }
        },
        "inputs": {
          "title": "Inputs",
          "description": "Variables the monitor reads.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/identifier" }
        },
        "outputs": {
          "title": "Outputs",
          "description": "Values the monitor publishes, in order: property verdicts and computed variables.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/dottedPath" }
        },
        "parameters": {
          "title": "Parameters",
          "description": "Variables fixed before the run.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "namespace": {
      "title": "Namespace",
      "description": "A leaf, holding rules, properties and extras, or an intermediate namespace, holding nested namespaces alone. No namespace is both.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "properties": {
        "rules": {
          "title": "Rules",
          "description": "Rules of the namespace, keyed by name.",
          "$ref": "#/definitions/ruleTable"
        },
        "properties": {
          "title": "Properties",
          "description": "Properties of the namespace, keyed by name.",
          "$ref": "#/definitions/propertyTable"
        },
        "extras": {
          "title": "Extras",
          "description": "Free-form data about the namespace. The format does not interpret it.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": { "$ref": "#/definitions/namespace" },
      "if": {
        "anyOf": [{ "required": ["rules"] }, { "required": ["properties"] }, { "required": ["extras"] }]
      },
      "then": {
        "title": "Leaf namespace",
        "description": "A namespace with rules, properties or extras holds no nested namespace.",
        "properties": { "rules": true, "properties": true, "extras": true },
        "additionalProperties": false
      }
    },
    "identifier": {
      "title": "Identifier",
      "description": "A letter or underscore, followed by letters, digits or underscores.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
    },
    "dottedPath": {
      "title": "Dotted path",
      "description": "Identifiers joined by dots.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
    },
    "variable": {
      "title": "Variable",
      "description": "A variable declaration. `type` selects the keys it may carry.",
      "type": "object",
      "properties": {
        "type": {
          "title": "Type",
          "description": "The value type. Defaults to `bool`.",
          "anyOf": [
            { "const": "bool", "description": "Boolean." },
            { "const": "number", "description": "Number." },
            {
              "const": "text",
              "description": "Structured text, such as JSON."
            },
            {
              "const": "binary",
              "description": "Binary data, such as FlatBuffers."
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": { "required": ["type"] }
              },
              {
                "properties": {
                  "type": { "const": "bool" }
                }
              }
            ]
          },
          "then": { "$ref": "#/definitions/boolVariable" }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "const": "number" }
            }
          },
          "then": { "$ref": "#/definitions/numberVariable" }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "const": "text" }
            }
          },
          "then": { "$ref": "#/definitions/textVariable" }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "const": "binary" }
            }
          },
          "then": { "$ref": "#/definitions/binaryVariable" }
        }
      ]
    },
    "variableCommon": {
      "title": "Common variable keys",
      "description": "Keys every variable may carry. Each variable type closes itself with `additionalProperties`, which sees only its own `properties`, so it lists these keys again.",
      "type": "object",
      "properties": {
        "type": true,
        "source": {
          "title": "Source",
          "description": "Path to the value inside a text or binary variable.",
          "$ref": "#/definitions/dottedPath"
        },
        "title": {
          "title": "Title",
          "description": "A short name.",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "description": "A longer explanation.",
          "type": "string"
        },
        "extras": {
          "title": "Extras",
          "description": "Free-form data about the variable. The format does not interpret it.",
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "boolVariable": {
      "title": "Boolean variable",
      "type": "object",
      "allOf": [{ "$ref": "#/definitions/variableCommon" }],
      "properties": {
        "type": true,
        "source": true,
        "title": true,
        "description": true,
        "extras": true,
        "initial_value": {
          "title": "Initial value",
          "description": "Value before the first sample.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "numberVariable": {
      "title": "Number variable",
      "type": "object",
      "allOf": [{ "$ref": "#/definitions/variableCommon" }],
      "properties": {
        "type": true,
        "source": true,
        "title": true,
        "description": true,
        "extras": true,
        "initial_value": {
          "title": "Initial value",
          "description": "Value before the first sample.",
          "type": "number"
        },
        "min": {
          "title": "Minimum",
          "description": "Smallest value the variable takes.",
          "type": "number"
        },
        "max": {
          "title": "Maximum",
          "description": "Largest value the variable takes.",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "textVariable": {
      "title": "Text variable",
      "type": "object",
      "allOf": [{ "$ref": "#/definitions/variableCommon" }],
      "properties": {
        "type": true,
        "source": true,
        "title": true,
        "description": true,
        "extras": true,
        "format": {
          "title": "Format",
          "description": "Encoding of the text.",
          "$ref": "#/definitions/textFormat"
        }
      },
      "additionalProperties": false
    },
    "binaryVariable": {
      "title": "Binary variable",
      "type": "object",
      "allOf": [{ "$ref": "#/definitions/variableCommon" }],
      "properties": {
        "type": true,
        "source": true,
        "title": true,
        "description": true,
        "extras": true,
        "format": {
          "title": "Format",
          "description": "Encoding of the data.",
          "$ref": "#/definitions/binaryFormat"
        }
      },
      "additionalProperties": false
    },
    "textFormat": { "title": "Text format", "anyOf": [{ "const": "json", "description": "JSON." }] },
    "binaryFormat": {
      "title": "Binary format",
      "anyOf": [{ "const": "flatbuffers", "description": "FlatBuffers." }]
    },
    "expression": {
      "title": "Expression",
      "description": "A rule in expression syntax, enclosed in parentheses. Atoms are braced: `{p}`, `{guard}`, `{speed < 30}`, `{s := sensor_id}`. A metric bound follows its operator as `[min:max:unit]`, each field optional. A quantifier lists its names in brackets, as `forall[s]`. The schema checks only the parentheses.",
      "type": "string",
      "pattern": "^\\([\\s\\S]*\\S[\\s\\S]*\\)(?![\\s\\S])"
    },
    "timeBoundValue": {
      "title": "Bound value",
      "description": "A non-negative number or a parameter.",
      "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/definitions/identifier" }]
    },
    "timeBound": {
      "title": "Metric bound",
      "description": "Time window of a temporal operator.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": { "title": "Lower end", "$ref": "#/definitions/timeBoundValue" },
        "max": { "title": "Upper end", "$ref": "#/definitions/timeBoundValue" },
        "time_unit": {
          "title": "Time unit",
          "description": "Unit of both ends. Defaults to the property's `time_unit`, then the monitor's.",
          "$ref": "#/definitions/timeUnit"
        }
      },
      "dependencies": {
        "time_unit": {
          "title": "Unit needs an end",
          "description": "A bound with `time_unit` has `min` or `max`.",
          "anyOf": [{ "required": ["min"] }, { "required": ["max"] }]
        }
      }
    },
    "timeUnit": {
      "title": "Time unit",
      "anyOf": [
        { "const": "ns", "description": "Nanoseconds." },
        { "const": "us", "description": "Microseconds." },
        { "const": "ms", "description": "Milliseconds." },
        { "const": "s", "description": "Seconds." },
        { "const": "min", "description": "Minutes." },
        { "const": "h", "description": "Hours." },
        { "const": "d", "description": "Days." }
      ]
    },
    "rule": {
      "title": "Rule",
      "description": "A rule in prefix or expression syntax. A string opening with `(` is an expression, and anything else a prefix rule.",
      "if": { "type": "string", "pattern": "^\\(" },
      "then": { "$ref": "#/definitions/expression" },
      "else": { "$ref": "#/definitions/prefixRule" }
    },
    "prefixRule": {
      "title": "Prefix rule",
      "description": "A reference, or an array: an operator followed by its operands. The operator alone picks the shape, so an error names the operand at fault.",
      "type": ["string", "array"],
      "if": { "type": "string" },
      "then": { "$ref": "#/definitions/dottedPath" },
      "else": {
        "minItems": 1,
        "items": [{ "$ref": "#/definitions/operator" }],
        "allOf": [
          {
            "if": { "minItems": 1, "items": [{ "enum": ["lt", "le", "gt", "ge"] }] },
            "then": { "$ref": "#/definitions/numberPredicateRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "enum": ["contains", "startswith", "endswith"] }] },
            "then": { "$ref": "#/definitions/stringPredicateRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/comparisonOperator" }] },
            "then": { "$ref": "#/definitions/comparisonRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/quantifiedAssignmentOperator" }] },
            "then": { "$ref": "#/definitions/quantifiedAssignmentRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/quantifierOperator" }] },
            "then": { "$ref": "#/definitions/quantifiedRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/multiaryOperator" }] },
            "then": { "$ref": "#/definitions/multiaryRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/unaryOperator" }] },
            "then": { "$ref": "#/definitions/unaryRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/stepTemporalOperator" }] },
            "then": { "$ref": "#/definitions/stepTemporalRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/unaryTemporalOperator" }] },
            "then": { "$ref": "#/definitions/unaryTemporalRule" }
          },
          {
            "if": { "minItems": 1, "items": [{ "$ref": "#/definitions/binaryTemporalOperator" }] },
            "then": { "$ref": "#/definitions/binaryTemporalRule" }
          }
        ]
      }
    },
    "operator": {
      "title": "Operator",
      "description": "The first element of a prefix rule.",
      "anyOf": [
        { "$ref": "#/definitions/numberPredicateOperator" },
        { "$ref": "#/definitions/stringPredicateOperator" },
        { "$ref": "#/definitions/quantifiedAssignmentOperator" },
        { "$ref": "#/definitions/quantifierOperator" },
        { "$ref": "#/definitions/multiaryOperator" },
        { "$ref": "#/definitions/unaryOperator" },
        { "$ref": "#/definitions/stepTemporalOperator" },
        { "$ref": "#/definitions/unaryTemporalOperator" },
        { "$ref": "#/definitions/binaryTemporalOperator" }
      ]
    },
    "unaryOperator": {
      "title": "Unary operator",
      "anyOf": [{ "const": "not", "description": "Negation." }]
    },
    "stepTemporalOperator": {
      "title": "Step temporal operator",
      "anyOf": [
        {
          "const": "prev",
          "description": "Holds if the operand held at the previous step."
        },
        {
          "const": "next",
          "description": "Holds if the operand holds at the next step."
        }
      ]
    },
    "multiaryOperator": {
      "title": "N-ary operator",
      "anyOf": [
        {
          "const": "and",
          "description": "Holds if every operand holds."
        },
        {
          "const": "or",
          "description": "Holds if at least one operand holds."
        },
        {
          "const": "xor",
          "description": "Holds if an odd number of operands hold."
        },
        {
          "const": "equiv",
          "description": "Holds if all operands have the same truth value."
        },
        {
          "const": "implies",
          "description": "Holds if each operand implies the next, associating to the right."
        }
      ]
    },
    "numberPredicateOperator": {
      "title": "Number comparison operator",
      "anyOf": [
        { "const": "lt", "description": "Strictly less than." },
        { "const": "le", "description": "Less than or equal to." },
        { "const": "gt", "description": "Strictly greater than." },
        {
          "const": "ge",
          "description": "Greater than or equal to."
        },
        { "const": "eq", "description": "Equal to." },
        { "const": "ne", "description": "Not equal to." }
      ]
    },
    "numberPredicateRule": {
      "title": "Number comparison",
      "description": "`[operator, variable, variable or number literal]`.",
      "type": "array",
      "items": [
        { "$ref": "#/definitions/numberPredicateOperator" },
        { "$ref": "#/definitions/identifier" },
        { "if": { "type": "string" }, "then": { "$ref": "#/definitions/identifier" }, "else": { "$ref": "#/definitions/numberLiteral" } }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "stringPredicateOperator": {
      "title": "String comparison operator",
      "anyOf": [
        { "const": "eq", "description": "Equal to." },
        { "const": "ne", "description": "Not equal to." },
        {
          "const": "contains",
          "description": "Contains the operand as a substring."
        },
        {
          "const": "startswith",
          "description": "Begins with the operand."
        },
        {
          "const": "endswith",
          "description": "Ends with the operand."
        }
      ]
    },
    "stringPredicateRule": {
      "title": "String comparison",
      "description": "`[operator, variable, variable or string literal]`.",
      "type": "array",
      "items": [
        { "$ref": "#/definitions/stringPredicateOperator" },
        { "$ref": "#/definitions/identifier" },
        { "if": { "type": "string" }, "then": { "$ref": "#/definitions/identifier" }, "else": { "$ref": "#/definitions/stringLiteral" } }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "comparisonOperator": {
      "title": "Equality operator",
      "description": "The operators both comparison families share. Which family a rule belongs to is settled by its operands' types, not its shape.",
      "anyOf": [
        { "const": "eq", "description": "Equal to." },
        { "const": "ne", "description": "Not equal to." }
      ]
    },
    "comparisonRule": {
      "title": "Equality comparison",
      "description": "`[eq or ne, variable, variable or literal]`: a number comparison or a string comparison.",
      "type": "array",
      "items": [
        { "$ref": "#/definitions/comparisonOperator" },
        { "$ref": "#/definitions/identifier" },
        { "if": { "type": "string" }, "then": { "$ref": "#/definitions/identifier" }, "else": { "$ref": "#/definitions/literal" } }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "literal": {
      "title": "Literal",
      "description": "A number or string operand.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "title": "Value", "type": ["number", "string"] }
      }
    },
    "numberLiteral": {
      "title": "Number literal",
      "description": "A number operand.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "title": "Value", "type": "number" }
      }
    },
    "stringLiteral": {
      "title": "String literal",
      "description": "A string operand.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "title": "Value", "type": "string" }
      }
    },
    "quantifiedAssignmentOperator": {
      "title": "Assignment operator",
      "anyOf": [
        {
          "const": "assign",
          "description": "Holds if the quantified variable's binding equals the variable's current value."
        }
      ]
    },
    "quantifiedAssignmentRule": {
      "title": "Assignment",
      "description": "`[assign, variable, quantified variable]`.",
      "type": "array",
      "items": [
        { "$ref": "#/definitions/quantifiedAssignmentOperator" },
        { "$ref": "#/definitions/identifier" },
        { "$ref": "#/definitions/quantifiedVariable" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "quantifiedVariable": {
      "title": "Quantified variable",
      "description": "A name bound by `forall` or `exists`.",
      "type": "object",
      "required": ["qvar"],
      "additionalProperties": false,
      "properties": {
        "qvar": { "title": "Name", "$ref": "#/definitions/identifier" }
      }
    },
    "quantifierOperator": {
      "title": "Quantifier",
      "anyOf": [
        {
          "const": "forall",
          "description": "Holds if the rule holds for every binding."
        },
        {
          "const": "exists",
          "description": "Holds if the rule holds for some binding."
        }
      ]
    },
    "binding": {
      "title": "Binding",
      "description": "Names bound by a quantifier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["qvars"],
      "properties": {
        "qvars": {
          "title": "Quantified variables",
          "description": "One or more names, each listed once.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/identifier" }
        }
      }
    },
    "unaryTemporalOperator": {
      "title": "Unary temporal operator",
      "anyOf": [
        {
          "const": "once",
          "description": "Holds if the operand held at some past point."
        },
        {
          "const": "historically",
          "description": "Holds if the operand held at every past point."
        },
        {
          "const": "eventually",
          "description": "Holds if the operand holds at some future point."
        },
        {
          "const": "always",
          "description": "Holds if the operand holds at every future point."
        }
      ]
    },
    "binaryTemporalOperator": {
      "title": "Binary temporal operator",
      "anyOf": [
        {
          "const": "since",
          "description": "Holds if the second operand held at some past point and the first has held since."
        },
        {
          "const": "until",
          "description": "Holds if the second operand holds at some future point and the first holds until then."
        }
      ]
    },
    "quantifiedRule": {
      "title": "Quantified rule",
      "description": "`[quantifier, rule, binding]`.",
      "type": "array",
      "items": [
        { "$ref": "#/definitions/quantifierOperator" },
        { "$ref": "#/definitions/prefixRule" },
        { "$ref": "#/definitions/binding" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "unaryRule": {
      "title": "Unary rule",
      "description": "`[operator, rule]`.",
      "type": "array",
      "items": [{ "$ref": "#/definitions/unaryOperator" }, { "$ref": "#/definitions/prefixRule" }],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "stepTemporalRule": {
      "title": "Step temporal rule",
      "description": "`[operator, rule]`.",
      "type": "array",
      "items": [{ "$ref": "#/definitions/stepTemporalOperator" }, { "$ref": "#/definitions/prefixRule" }],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "multiaryRule": {
      "title": "N-ary rule",
      "description": "`[operator, rule, rule, ...]`.",
      "type": "array",
      "items": [
        { "$ref": "#/definitions/multiaryOperator" },
        { "$ref": "#/definitions/prefixRule" },
        { "$ref": "#/definitions/prefixRule" }
      ],
      "minItems": 3,
      "additionalItems": { "$ref": "#/definitions/prefixRule" }
    },
    "unaryTemporalRule": {
      "title": "Unary temporal rule",
      "description": "`[operator, rule]`, optionally followed by a metric bound.",
      "type": "array",
      "items": [{ "$ref": "#/definitions/unaryTemporalOperator" }, { "$ref": "#/definitions/prefixRule" }],
      "minItems": 2,
      "maxItems": 3,
      "additionalItems": { "$ref": "#/definitions/timeBound" }
    },
    "binaryTemporalRule": {
      "title": "Binary temporal rule",
      "description": "`[operator, rule, rule]`, optionally followed by a metric bound on the second operand.",
      "type": "array",
      "items": [
        { "$ref": "#/definitions/binaryTemporalOperator" },
        { "$ref": "#/definitions/prefixRule" },
        { "$ref": "#/definitions/prefixRule" }
      ],
      "minItems": 3,
      "maxItems": 4,
      "additionalItems": { "$ref": "#/definitions/timeBound" }
    },
    "propertyTable": {
      "title": "Property table",
      "description": "Properties by name.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/property" }
    },
    "ruleTable": {
      "title": "Rule table",
      "description": "Rules by name.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/identifier" },
      "additionalProperties": { "$ref": "#/definitions/rule" }
    },
    "property": {
      "title": "Property",
      "description": "A requirement: whenever `given` holds, `check` holds.",
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "description": "A short name.",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "description": "A longer explanation.",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "description": "Text reported when the property is violated.",
          "type": "string"
        },
        "time_unit": {
          "title": "Time unit",
          "description": "Default unit of the metric bounds in this property.",
          "$ref": "#/definitions/timeUnit"
        },
        "tags": {
          "title": "Tags",
          "description": "Labels for selecting and grouping properties.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\S+(?![\\s\\S])" }
        },
        "given": {
          "title": "Given",
          "description": "Condition under which `check` is required.",
          "$ref": "#/definitions/rule"
        },
        "check": {
          "title": "Check",
          "description": "The requirement.",
          "$ref": "#/definitions/rule"
        },
        "where": {
          "title": "Local rules",
          "description": "Rules visible only to this property.",
          "$ref": "#/definitions/ruleTable"
        },
        "extras": {
          "title": "Extras",
          "description": "Free-form data about the property. The format does not interpret it.",
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
