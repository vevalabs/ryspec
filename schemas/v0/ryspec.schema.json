{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vevalabs/ryspec/main/schemas/v0/ryspec.schema.json",
  "title": "ryspec document",
  "description": "A ryspec specification document.",
  "type": "object",
  "required": ["version"],
  "propertyNames": { "$ref": "#/$defs/identifier" },
  "additionalProperties": { "$ref": "#/$defs/namespaceTable" },
  "properties": {
    "version": {
      "title": "Format version",
      "description": "The ryspec format version the document targets.",
      "type": "string",
      "const": "0"
    },
    "meta": {
      "title": "Metadata",
      "description": "Descriptive information about the document.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "description": "A short name for the document.",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "description": "A summary of the document.",
          "type": "string"
        }
      }
    },
    "variables": {
      "title": "Variables",
      "description": "Declarations of the values monitors read, publish or are configured with.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/variable" }
    },
    "monitors": {
      "title": "Monitors",
      "description": "Runtime interfaces over the document's properties.",
      "type": "array",
      "items": { "$ref": "#/$defs/monitor" }
    },
    "rules": {
      "title": "Rules",
      "description": "Named rules of the anonymous namespace.",
      "$ref": "#/$defs/ruleTable"
    },
    "properties": {
      "title": "Properties",
      "description": "Properties of the anonymous namespace.",
      "$ref": "#/$defs/propertyTable"
    },
    "extras": {
      "title": "Extras",
      "description": "Free-form data. The format does not interpret it.",
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "monitor": {
      "title": "Monitor",
      "description": "A runtime interface: the variables it reads and publishes, and its runtime settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "title": "Runtime",
          "description": "Settings of the monitor runtime.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allocation_size": {
              "title": "Allocation size",
              "description": "Allocation size of the monitor runtime.",
              "type": "integer",
              "minimum": 1
            },
            "buffer_size": {
              "title": "Buffer size",
              "description": "Buffer size of the monitor runtime.",
              "type": "integer",
              "minimum": 1
            },
            "base_period": {
              "title": "Base period",
              "description": "Time between two consecutive samples, in the monitor's `time_unit`.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "time_unit": {
              "title": "Time unit",
              "description": "Unit of the monitor's timestamps, and the default unit of metric bounds.",
              "$ref": "#/$defs/timeUnit"
            }
          }
        },
        "inputs": {
          "title": "Inputs",
          "description": "Variables the monitor reads.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "outputs": {
          "title": "Outputs",
          "description": "Values the monitor publishes: property verdicts and variables.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ruleRef" }
        },
        "parameters": {
          "title": "Parameters",
          "description": "Variables fixed before the run.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "namespaceTable": {
      "title": "Namespace",
      "description": "A named group of rules and properties, or of nested namespaces.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "properties": {
        "variables": { "description": "Not allowed in a namespace.", "not": {} },
        "meta": { "description": "Not allowed in a namespace.", "not": {} },
        "version": { "description": "Not allowed in a namespace.", "not": {} },
        "monitors": { "description": "Not allowed in a namespace.", "not": {} },
        "extras": { "description": "Not allowed in a namespace.", "not": {} },
        "rules": {
          "title": "Rules",
          "description": "Named rules of the namespace.",
          "$ref": "#/$defs/ruleTable"
        },
        "properties": {
          "title": "Properties",
          "description": "Properties of the namespace.",
          "$ref": "#/$defs/propertyTable"
        }
      },
      "additionalProperties": { "$ref": "#/$defs/namespaceTable" },
      "if": { "anyOf": [{ "required": ["rules"] }, { "required": ["properties"] }] },
      "then": {
        "title": "Namespace with logic",
        "description": "A namespace with rules or properties has no nested namespaces. The document root is exempt.",
        "properties": { "rules": true, "properties": true },
        "additionalProperties": false
      }
    },
    "identifier": {
      "title": "Identifier",
      "description": "A letter or underscore, followed by letters, digits or underscores.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
    },
    "dottedPath": {
      "title": "Dotted path",
      "description": "Identifiers joined by dots.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
    },
    "varRef": {
      "title": "Variable reference",
      "description": "The name of a declared variable.",
      "$ref": "#/$defs/identifier"
    },
    "ruleRef": {
      "title": "Rule reference",
      "description": "The name of a rule or property, bare or prefixed by its namespace path.",
      "$ref": "#/$defs/dottedPath"
    },
    "variable": {
      "title": "Variable",
      "description": "A variable declaration. `type` selects the keys it may carry.",
      "type": "object",
      "properties": {
        "type": {
          "title": "Type",
          "description": "The value type. Defaults to `bool`.",
          "anyOf": [
            { "const": "bool", "description": "Boolean." },
            { "const": "number", "description": "Number." },
            {
              "const": "text",
              "description": "Structured text, such as JSON."
            },
            {
              "const": "binary",
              "description": "Binary data, such as FlatBuffers."
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": { "required": ["type"] }
              },
              {
                "properties": {
                  "type": { "const": "bool" }
                }
              }
            ]
          },
          "then": { "$ref": "#/$defs/boolVariable" }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "const": "number" }
            }
          },
          "then": { "$ref": "#/$defs/numberVariable" }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "const": "text" }
            }
          },
          "then": { "$ref": "#/$defs/textVariable" }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": { "const": "binary" }
            }
          },
          "then": { "$ref": "#/$defs/binaryVariable" }
        }
      ]
    },
    "variableCommon": {
      "title": "Common variable keys",
      "description": "Keys every variable may carry.",
      "type": "object",
      "properties": {
        "type": true,
        "source": {
          "title": "Source",
          "description": "Path to the value inside a text or binary variable.",
          "$ref": "#/$defs/dottedPath"
        },
        "title": {
          "title": "Title",
          "description": "A short name.",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "description": "A longer explanation.",
          "type": "string"
        }
      }
    },
    "boolVariable": {
      "title": "Boolean variable",
      "type": "object",
      "$ref": "#/$defs/variableCommon",
      "properties": {
        "initial_value": {
          "title": "Initial value",
          "description": "Value before the first sample.",
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    },
    "numberVariable": {
      "title": "Number variable",
      "type": "object",
      "$ref": "#/$defs/variableCommon",
      "properties": {
        "initial_value": {
          "title": "Initial value",
          "description": "Value before the first sample.",
          "type": "number"
        },
        "min": {
          "title": "Minimum",
          "description": "Smallest value the variable takes.",
          "type": "number"
        },
        "max": {
          "title": "Maximum",
          "description": "Largest value the variable takes.",
          "type": "number"
        }
      },
      "unevaluatedProperties": false
    },
    "textVariable": {
      "title": "Text variable",
      "type": "object",
      "$ref": "#/$defs/variableCommon",
      "properties": {
        "format": {
          "title": "Format",
          "description": "Encoding of the text.",
          "$ref": "#/$defs/textFormat"
        }
      },
      "unevaluatedProperties": false
    },
    "binaryVariable": {
      "title": "Binary variable",
      "type": "object",
      "$ref": "#/$defs/variableCommon",
      "properties": {
        "format": {
          "title": "Format",
          "description": "Encoding of the data.",
          "$ref": "#/$defs/binaryFormat"
        }
      },
      "unevaluatedProperties": false
    },
    "textFormat": { "title": "Text format", "anyOf": [{ "const": "json", "description": "JSON." }] },
    "binaryFormat": {
      "title": "Binary format",
      "anyOf": [{ "const": "flatbuffers", "description": "FlatBuffers." }]
    },
    "expression": {
      "title": "Expression",
      "description": "A rule in expression syntax, enclosed in parentheses. Atoms are braced: `{p}`, `{guard}`, `{speed < 30}`, `{s := sensor_id}`. A metric bound follows its operator as `[min:max:unit]`, each field optional. A quantifier lists its names in brackets, as `forall[s]`. The schema checks only the parentheses.",
      "type": "string",
      "pattern": "^\\([\\s\\S]*\\S[\\s\\S]*\\)(?![\\s\\S])"
    },
    "timeBoundValue": {
      "title": "Bound value",
      "description": "A non-negative number or a parameter.",
      "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/varRef" }]
    },
    "timeBound": {
      "title": "Metric bound",
      "description": "Time window of a temporal operator.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": { "title": "Lower end", "$ref": "#/$defs/timeBoundValue" },
        "max": { "title": "Upper end", "$ref": "#/$defs/timeBoundValue" },
        "time_unit": {
          "title": "Time unit",
          "description": "Unit of both ends. Defaults to the property's `time_unit`, then the monitor's.",
          "$ref": "#/$defs/timeUnit"
        }
      },
      "dependentSchemas": {
        "time_unit": {
          "title": "Unit needs an end",
          "description": "A bound with `time_unit` has `min` or `max`.",
          "anyOf": [{ "required": ["min"] }, { "required": ["max"] }]
        }
      }
    },
    "timeUnit": {
      "title": "Time unit",
      "anyOf": [
        { "const": "ns", "description": "Nanoseconds." },
        { "const": "us", "description": "Microseconds." },
        { "const": "ms", "description": "Milliseconds." },
        { "const": "s", "description": "Seconds." },
        { "const": "min", "description": "Minutes." },
        { "const": "h", "description": "Hours." },
        { "const": "d", "description": "Days." }
      ]
    },
    "rule": {
      "title": "Rule",
      "description": "A rule in prefix or expression syntax.",
      "anyOf": [{ "$ref": "#/$defs/expression" }, { "$ref": "#/$defs/prefixRule" }]
    },
    "prefixRule": {
      "title": "Prefix rule",
      "description": "A reference, or an array: an operator followed by its operands.",
      "anyOf": [
        { "$ref": "#/$defs/ruleRef" },
        { "$ref": "#/$defs/varRef" },
        { "$ref": "#/$defs/numberPredicateRule" },
        { "$ref": "#/$defs/stringPredicateRule" },
        { "$ref": "#/$defs/quantifiedAssignmentRule" },
        { "$ref": "#/$defs/quantifiedRule" },
        { "$ref": "#/$defs/multiaryRule" },
        { "$ref": "#/$defs/unaryRule" },
        { "$ref": "#/$defs/stepTemporalRule" },
        { "$ref": "#/$defs/unaryTemporalRule" },
        { "$ref": "#/$defs/binaryTemporalRule" }
      ]
    },
    "unaryOperator": {
      "title": "Unary operator",
      "anyOf": [{ "const": "not", "description": "Negation." }]
    },
    "stepTemporalOperator": {
      "title": "Step temporal operator",
      "anyOf": [
        {
          "const": "prev",
          "description": "Holds if the operand held at the previous step."
        },
        {
          "const": "next",
          "description": "Holds if the operand holds at the next step."
        }
      ]
    },
    "multiaryOperator": {
      "title": "N-ary operator",
      "anyOf": [
        {
          "const": "and",
          "description": "Holds if every operand holds."
        },
        {
          "const": "or",
          "description": "Holds if at least one operand holds."
        },
        {
          "const": "xor",
          "description": "Holds if an odd number of operands hold."
        },
        {
          "const": "equiv",
          "description": "Holds if all operands have the same truth value."
        },
        {
          "const": "implies",
          "description": "Holds if each operand implies the next, associating to the right."
        }
      ]
    },
    "numberPredicateOperator": {
      "title": "Number comparison operator",
      "anyOf": [
        { "const": "lt", "description": "Strictly less than." },
        { "const": "le", "description": "Less than or equal to." },
        { "const": "gt", "description": "Strictly greater than." },
        {
          "const": "ge",
          "description": "Greater than or equal to."
        },
        { "const": "eq", "description": "Equal to." },
        { "const": "ne", "description": "Not equal to." }
      ]
    },
    "numberPredicateRule": {
      "title": "Number comparison",
      "description": "`[operator, variable, variable or number literal]`.",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/numberPredicateOperator" },
        { "$ref": "#/$defs/varRef" },
        { "anyOf": [{ "$ref": "#/$defs/varRef" }, { "$ref": "#/$defs/numberLiteral" }] }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "stringPredicateOperator": {
      "title": "String comparison operator",
      "anyOf": [
        { "const": "eq", "description": "Equal to." },
        { "const": "ne", "description": "Not equal to." },
        {
          "const": "contains",
          "description": "Contains the operand as a substring."
        },
        {
          "const": "startswith",
          "description": "Begins with the operand."
        },
        {
          "const": "endswith",
          "description": "Ends with the operand."
        }
      ]
    },
    "stringPredicateRule": {
      "title": "String comparison",
      "description": "`[operator, variable, variable or string literal]`.",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/stringPredicateOperator" },
        { "$ref": "#/$defs/varRef" },
        { "anyOf": [{ "$ref": "#/$defs/varRef" }, { "$ref": "#/$defs/stringLiteral" }] }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "numberLiteral": {
      "title": "Number literal",
      "description": "A number operand.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "title": "Value", "type": "number" }
      }
    },
    "stringLiteral": {
      "title": "String literal",
      "description": "A string operand.",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "title": "Value", "type": "string" }
      }
    },
    "quantifiedAssignmentOperator": {
      "title": "Assignment operator",
      "anyOf": [
        {
          "const": "assign",
          "description": "Holds if the quantified variable's binding equals the variable's current value."
        }
      ]
    },
    "quantifiedAssignmentRule": {
      "title": "Assignment",
      "description": "`[assign, variable, quantified variable]`.",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/quantifiedAssignmentOperator" },
        { "$ref": "#/$defs/varRef" },
        { "$ref": "#/$defs/quantifiedVariable" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "quantifiedVariable": {
      "title": "Quantified variable",
      "description": "A name bound by `forall` or `exists`.",
      "type": "object",
      "required": ["qvar"],
      "additionalProperties": false,
      "properties": {
        "qvar": { "title": "Name", "$ref": "#/$defs/identifier" }
      }
    },
    "quantifierOperator": {
      "title": "Quantifier",
      "anyOf": [
        {
          "const": "forall",
          "description": "Holds if the rule holds for every binding."
        },
        {
          "const": "exists",
          "description": "Holds if the rule holds for some binding."
        }
      ]
    },
    "binding": {
      "title": "Binding",
      "description": "Names bound by a quantifier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["qvars"],
      "properties": {
        "qvars": {
          "title": "Quantified variables",
          "description": "One or more names, each listed once.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "unaryTemporalOperator": {
      "title": "Unary temporal operator",
      "anyOf": [
        {
          "const": "once",
          "description": "Holds if the operand held at some past point."
        },
        {
          "const": "historically",
          "description": "Holds if the operand held at every past point."
        },
        {
          "const": "eventually",
          "description": "Holds if the operand holds at some future point."
        },
        {
          "const": "always",
          "description": "Holds if the operand holds at every future point."
        }
      ]
    },
    "binaryTemporalOperator": {
      "title": "Binary temporal operator",
      "anyOf": [
        {
          "const": "since",
          "description": "Holds if the second operand held at some past point and the first has held since."
        },
        {
          "const": "until",
          "description": "Holds if the second operand holds at some future point and the first holds until then."
        }
      ]
    },
    "quantifiedRule": {
      "title": "Quantified rule",
      "description": "`[quantifier, rule, binding]`.",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/quantifierOperator" },
        { "$ref": "#/$defs/prefixRule" },
        { "$ref": "#/$defs/binding" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "unaryRule": {
      "title": "Unary rule",
      "description": "`[operator, rule]`.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/unaryOperator" }, { "$ref": "#/$defs/prefixRule" }],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "stepTemporalRule": {
      "title": "Step temporal rule",
      "description": "`[operator, rule]`.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/stepTemporalOperator" }, { "$ref": "#/$defs/prefixRule" }],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "multiaryRule": {
      "title": "N-ary rule",
      "description": "`[operator, rule, rule, ...]`.",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/multiaryOperator" },
        { "$ref": "#/$defs/prefixRule" },
        { "$ref": "#/$defs/prefixRule" }
      ],
      "minItems": 3,
      "items": { "$ref": "#/$defs/prefixRule" }
    },
    "unaryTemporalRule": {
      "title": "Unary temporal rule",
      "description": "`[operator, rule]`, optionally followed by a metric bound.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/unaryTemporalOperator" }, { "$ref": "#/$defs/prefixRule" }],
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/timeBound" }
    },
    "binaryTemporalRule": {
      "title": "Binary temporal rule",
      "description": "`[operator, rule, rule]`, optionally followed by a metric bound on the second operand.",
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/binaryTemporalOperator" },
        { "$ref": "#/$defs/prefixRule" },
        { "$ref": "#/$defs/prefixRule" }
      ],
      "minItems": 3,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/timeBound" }
    },
    "propertyTable": {
      "title": "Property table",
      "description": "Properties by name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/property" }
    },
    "ruleTable": {
      "title": "Rule table",
      "description": "Rules by name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/rule" }
    },
    "property": {
      "title": "Property",
      "description": "A requirement: whenever `given` holds, `check` holds.",
      "type": "object",
      "required": ["check"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "description": "A short name.",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "description": "A longer explanation.",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "description": "Text reported when the property is violated.",
          "type": "string"
        },
        "time_unit": {
          "title": "Time unit",
          "description": "Default unit of the metric bounds in this property.",
          "$ref": "#/$defs/timeUnit"
        },
        "tags": {
          "title": "Tags",
          "description": "Labels for selecting and grouping properties.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\S+(?![\\s\\S])" }
        },
        "given": {
          "title": "Given",
          "description": "Condition under which `check` is required.",
          "$ref": "#/$defs/rule"
        },
        "check": {
          "title": "Check",
          "description": "The requirement.",
          "$ref": "#/$defs/rule"
        },
        "where": {
          "title": "Local rules",
          "description": "Rules visible only to this property.",
          "$ref": "#/$defs/ruleTable"
        },
        "extras": {
          "title": "Extras",
          "description": "Free-form data about the property. The format does not interpret it.",
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
