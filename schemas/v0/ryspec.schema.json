{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/vevalabs/ryspec/schemas/v0/ryspec.schema.json",
  "title": "Reelay Specification Schema",
  "type": "object",
  "required": ["version", "properties"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "title": "Format version",
      "description": "The ryspec schema version this document targets.",
      "const": 0
    },
    "namespace": {
      "$ref": "#/$defs/dottedName"
    },
    "features": {
      "title": "Format flags for the document",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disable_expressions": {
          "description": "RESERVED"
        }
      }
    },
    "variables": {
      "title": "Value space",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/variable" }
    },
    "monitor": {
      "title": "Monitor interface",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "title": "Build sizing",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allocation_size": {
              "type": "integer",
              "minimum": 1
            },
            "buffer_size": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "$ref": "#/$defs/dottedName" }
        },
        "parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "required": ["inputs", "outputs"]
    },
    "meta": {
      "title": "Document metadata",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "description": { "type": "string" },
        "url": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^\\S+(?![\\s\\S])",
          "minLength": 1
        }
      }
    },
    "extras": {
      "title": "Free-form extension data",
      "type": "object",
      "additionalProperties": true
    },
    "rules": {
      "title": "File-level rules",
      "allOf": [{ "$ref": "#/$defs/ruleTable" }]
    },
    "properties": {
      "title": "Properties",
      "description": "The properties this document declares, each yielding one verdict. The table is required and may be empty: a document that declares none is well-formed and checks nothing.",
      "type": "array",
      "items": { "$ref": "#/$defs/property" }
    }
  },
  "$defs": {
    "identifier": {
      "title": "Identifier",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
    },
    "dottedName": {
      "title": "Dotted path",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
    },
    "variable": {
      "title": "Variable",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/dottedName"
        },
        "format": {
          "title": "Decoded format",
          "description": "How to decode the value a source path reads into. Only a text or binary variable may carry one -- there is nothing to decode in a number -- and only an input carries one. Decoding happens in the loader, never in the runtime core.",
          "anyOf": [
            {
              "const": "json",
              "description": "A JSON document, whose fields other variables address through a dotted source path."
            }
          ]
        },
        "type": {
          "title": "Value type",
          "description": "Defaults to number when absent.",
          "anyOf": [
            {
              "const": "bool",
              "description": "A truth value."
            },
            {
              "const": "number",
              "description": "A numeric value. The default."
            },
            {
              "const": "text",
              "description": "A document. It holds no value a rule can compare -- give it a format and other variables read fields out of it through a source path."
            },
            {
              "const": "binary",
              "description": "A blob. It holds no value a rule can compare -- give it a format and other variables read fields out of it through a source path."
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "initial_value": {
          "type": ["number", "boolean"]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "bool" } }
          },
          "then": {
            "properties": { "initial_value": { "type": "boolean" } }
          }
        },
        {
          "if": {
            "anyOf": [
              { "not": { "required": ["type"] } },
              { "properties": { "type": { "const": "number" } } }
            ]
          },
          "then": {
            "properties": { "initial_value": { "type": "number" } }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["text", "binary"] } }
          },
          "then": {
            "not": { "required": ["initial_value"] }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["bool", "text", "binary"] } }
          },
          "then": {
            "not": { "anyOf": [{ "required": ["min"] }, { "required": ["max"] }] }
          }
        },
        {
          "if": {
            "anyOf": [
              { "not": { "required": ["type"] } },
              { "properties": { "type": { "enum": ["bool", "number"] } } }
            ]
          },
          "then": {
            "not": { "required": ["format"] }
          }
        }
      ]
    },
    "expression": {
      "title": "Expression",
      "type": "string",
      "pattern": "^\\([\\s\\S]*\\S[\\s\\S]*\\)(?![\\s\\S])"
    },
    "parameter": {
      "title": "Scalar operand",
      "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/identifier" }]
    },
    "boundValue": {
      "title": "Metric bound value",
      "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/identifier" }]
    },
    "bound": {
      "title": "Metric bound",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": { "$ref": "#/$defs/boundValue" },
        "max": { "$ref": "#/$defs/boundValue" }
      }
    },
    "rule": {
      "title": "Rule",
      "description": "Every rule sits in one time cone. The past operators (prev, once, historically, since) and the future ones (next, eventually, always, until) may not be mixed inside a single rule. A rule built only from names, expressions, comparisons, the quantifiers and the boolean operators carries no direction and belongs to both.",
      "anyOf": [
        { "$ref": "#/$defs/pastRule" },
        { "$ref": "#/$defs/futureRule" }
      ]
    },
    "atomRule": {
      "title": "Cone-free rule",
      "description": "A rule carrying no time direction of its own -- a name, an expression, or a comparison. It stands in either cone. A name resolving to a rule declared elsewhere carries that rule's direction, which the schema cannot follow; the semantic pass checks it.",
      "anyOf": [
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/expression" },
        { "$ref": "#/$defs/predicateRule" }
      ]
    },
    "notOperator": {
      "title": "Negation operator",
      "const": "not",
      "description": "Logical negation. Holds exactly when its operand does not. Carries no time direction."
    },
    "multiaryOperator": {
      "title": "N-ary operator",
      "anyOf": [
        {
          "const": "and",
          "description": "Holds when every operand holds."
        },
        {
          "const": "or",
          "description": "Holds when at least one operand holds."
        },
        {
          "const": "xor",
          "description": "Holds when exactly one operand holds."
        },
        {
          "const": "equiv",
          "description": "Holds when the operands all have the same truth value. Has no infix spelling, so a property using it writes that rule in prefix form."
        },
        {
          "const": "implies",
          "description": "Holds when each operand implies the next; the first is the antecedent and the last the consequent."
        }
      ]
    },
    "comparisonOperator": {
      "title": "Comparison operator",
      "description": "Compares a variable against a scalar operand -- a number written inline, or a name resolving to a parameter, another variable or an enclosing quantifier's variable. Spelled lt/le/gt/ge/eq/ne in prefix form and </<=/>/>=/==/!= in expression form.",
      "anyOf": [
        { "const": "lt", "description": "Strictly less than." },
        { "const": "le", "description": "Less than or equal to." },
        { "const": "gt", "description": "Strictly greater than." },
        { "const": "ge", "description": "Greater than or equal to." },
        { "const": "eq", "description": "Equal to." },
        { "const": "ne", "description": "Not equal to." }
      ]
    },
    "predicateRule": {
      "title": "Comparison predicate",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/comparisonOperator" },
        { "$ref": "#/$defs/identifier" },
        { "$ref": "#/$defs/parameter" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "quantifierOperator": {
      "title": "Quantifier",
      "description": "Binds one or more names to values drawn from the trace and holds when the quantified rule holds for the right share of them. The names are local to the quantifier: they are bound here and nowhere else, and they resolve to no variable, rule or property.",
      "anyOf": [
        {
          "const": "forall",
          "description": "Holds when the quantified rule holds for every binding of the quantified names."
        },
        {
          "const": "exists",
          "description": "Holds when the quantified rule holds for at least one binding of the quantified names."
        }
      ]
    },
    "binding": {
      "title": "Quantifier binding",
      "description": "The names a quantifier binds. Required and non-empty: a quantifier that binds nothing quantifies over nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["vars"],
      "properties": {
        "vars": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "pastRule": {
      "title": "Past-time rule",
      "description": "A rule whose temporal operators all look backward.",
      "anyOf": [
        { "$ref": "#/$defs/atomRule" },
        { "$ref": "#/$defs/pastNotRule" },
        { "$ref": "#/$defs/pastQuantifiedRule" },
        { "$ref": "#/$defs/pastMultiaryRule" },
        { "$ref": "#/$defs/pastStepRule" },
        { "$ref": "#/$defs/pastUnaryTemporalRule" },
        { "$ref": "#/$defs/pastBinaryTemporalRule" }
      ]
    },
    "pastStepOperator": {
      "title": "Past-time step operator",
      "const": "prev",
      "description": "The operand's value at the previous step. Has no infix spelling, so a property using it writes that rule in prefix form."
    },
    "pastUnaryTemporalOperator": {
      "title": "Past-time unary temporal operator",
      "anyOf": [
        {
          "const": "once",
          "description": "The operand held at some point in the past. Takes an optional metric bound narrowing how far back to look."
        },
        {
          "const": "historically",
          "description": "The operand held at every point in the past. Takes an optional metric bound narrowing how far back to look."
        }
      ]
    },
    "pastBinaryTemporalOperator": {
      "title": "Past-time binary temporal operator",
      "const": "since",
      "description": "The second operand held at some point in the past and the first has held at every point after it. Takes an optional metric bound on when the second operand held."
    },
    "pastQuantifiedRule": {
      "title": "Quantified rule (past-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/quantifierOperator" },
        { "$ref": "#/$defs/pastRule" },
        { "$ref": "#/$defs/binding" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "pastNotRule": {
      "title": "Negation (past-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/notOperator" },
        { "$ref": "#/$defs/pastRule" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "pastStepRule": {
      "title": "Step rule (past-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/pastStepOperator" },
        { "$ref": "#/$defs/pastRule" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "pastMultiaryRule": {
      "title": "N-ary rule (past-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/multiaryOperator" },
        { "$ref": "#/$defs/pastRule" },
        { "$ref": "#/$defs/pastRule" }
      ],
      "minItems": 3,
      "additionalItems": { "$ref": "#/$defs/pastRule" }
    },
    "pastUnaryTemporalRule": {
      "title": "Unary temporal rule (past-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/pastUnaryTemporalOperator" },
        { "$ref": "#/$defs/pastRule" }
      ],
      "minItems": 2,
      "maxItems": 3,
      "additionalItems": { "$ref": "#/$defs/bound" }
    },
    "pastBinaryTemporalRule": {
      "title": "Binary temporal rule (past-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/pastBinaryTemporalOperator" },
        { "$ref": "#/$defs/pastRule" },
        { "$ref": "#/$defs/pastRule" }
      ],
      "minItems": 3,
      "maxItems": 4,
      "additionalItems": { "$ref": "#/$defs/bound" }
    },
    "futureRule": {
      "title": "Future-time rule",
      "description": "A rule whose temporal operators all look forward.",
      "anyOf": [
        { "$ref": "#/$defs/atomRule" },
        { "$ref": "#/$defs/futureNotRule" },
        { "$ref": "#/$defs/futureQuantifiedRule" },
        { "$ref": "#/$defs/futureMultiaryRule" },
        { "$ref": "#/$defs/futureStepRule" },
        { "$ref": "#/$defs/futureUnaryTemporalRule" },
        { "$ref": "#/$defs/futureBinaryTemporalRule" }
      ]
    },
    "futureStepOperator": {
      "title": "Future-time step operator",
      "const": "next",
      "description": "The operand's value at the next step."
    },
    "futureUnaryTemporalOperator": {
      "title": "Future-time unary temporal operator",
      "anyOf": [
        {
          "const": "eventually",
          "description": "The operand holds at some point in the future. Takes an optional metric bound narrowing how far ahead to look."
        },
        {
          "const": "always",
          "description": "The operand holds at every point in the future. Takes an optional metric bound narrowing how far ahead to look."
        }
      ]
    },
    "futureBinaryTemporalOperator": {
      "title": "Future-time binary temporal operator",
      "const": "until",
      "description": "The second operand holds at some point in the future and the first holds at every point before it. Takes an optional metric bound on when the second operand holds."
    },
    "futureQuantifiedRule": {
      "title": "Quantified rule (future-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/quantifierOperator" },
        { "$ref": "#/$defs/futureRule" },
        { "$ref": "#/$defs/binding" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "futureNotRule": {
      "title": "Negation (future-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/notOperator" },
        { "$ref": "#/$defs/futureRule" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "futureStepRule": {
      "title": "Step rule (future-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/futureStepOperator" },
        { "$ref": "#/$defs/futureRule" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "futureMultiaryRule": {
      "title": "N-ary rule (future-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/multiaryOperator" },
        { "$ref": "#/$defs/futureRule" },
        { "$ref": "#/$defs/futureRule" }
      ],
      "minItems": 3,
      "additionalItems": { "$ref": "#/$defs/futureRule" }
    },
    "futureUnaryTemporalRule": {
      "title": "Unary temporal rule (future-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/futureUnaryTemporalOperator" },
        { "$ref": "#/$defs/futureRule" }
      ],
      "minItems": 2,
      "maxItems": 3,
      "additionalItems": { "$ref": "#/$defs/bound" }
    },
    "futureBinaryTemporalRule": {
      "title": "Binary temporal rule (future-time)",
      "type": "array",
      "items": [
        { "$ref": "#/$defs/futureBinaryTemporalOperator" },
        { "$ref": "#/$defs/futureRule" },
        { "$ref": "#/$defs/futureRule" }
      ],
      "minItems": 3,
      "maxItems": 4,
      "additionalItems": { "$ref": "#/$defs/bound" }
    },
    "ruleTable": {
      "title": "Rule table",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/rule" }
    },
    "property": {
      "title": "Property",
      "type": "object",
      "required": ["name", "check"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "criticality": {
          "title": "Criticality",
          "description": "How much a violation of this property matters. It classifies the verdict for whoever reads it and does not change how the property is evaluated.",
          "anyOf": [
            {
              "const": "info",
              "description": "Informational; a violation is worth recording and nothing more."
            },
            {
              "const": "warning",
              "description": "A violation is a concern but not a failure."
            },
            {
              "const": "error",
              "description": "A violation is a failure."
            },
            {
              "const": "critical",
              "description": "A violation is a failure that matters most -- a safety requirement."
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "given": {
          "$ref": "#/$defs/rule"
        },
        "check": {
          "$ref": "#/$defs/rule"
        },
        "impose": {
          "description": "RESERVED",
          "$ref": "#/$defs/rule"
        },
        "rules": {
          "$ref": "#/$defs/ruleTable"
        }
      }
    }
  }
}
